    {
      "id": "ur-word-order",
      "language": "ur",
      "title": "动词居末的语序",
      "english": "SOV Word Order",
      "category": "语序",
      "cefr": "A1",
      "formula": "主语 + 宾语 + 动词（SOV）",
      "summary": "乌尔都语动词固定在句末，基本语序为 SOV。语法关系由后置词和词尾标示，成分可以前移，但动词仍然收尾。",
      "sections": [
        {
          "heading": "基本语序",
          "body": "主语在前，宾语居中，动词最后；形容词和属格修饰语都放在中心词之前。",
          "bullets": [
            "میں چائے پیتا ہوں۔",
            "وہ کتاب پڑھتا ہے۔"
          ]
        },
        {
          "heading": "疑问句",
          "body": "疑问词留在原位，句首可加 کیا 构成一般疑问句，语序不必倒装。"
        },
        {
          "heading": "强调移位",
          "body": "需要强调的成分可以提到句首，但动词位置不动，仍在句末。"
        }
      ],
      "examples": [
        {
          "source": "میں ہر روز اردو پڑھتا ہوں۔",
          "translation": "我每天学乌尔都语。"
        },
        {
          "source": "اس نے مجھے ایک کتاب دی۔",
          "translation": "他给了我一本书。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "میں پڑھتا ہوں اردو۔",
          "right": "میں اردو پڑھتا ہوں۔",
          "why": "动词必须收尾，宾语不能后置。"
        },
        {
          "wrong": "کہاں تم رہتے ہو؟",
          "right": "تم کہاں رہتے ہو؟",
          "why": "疑问词不前置，留在原来的位置。"
        }
      ],
