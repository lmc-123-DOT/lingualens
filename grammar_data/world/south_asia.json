    {
      "id": "bn-cases",
      "language": "bn",
      "title": "名词的格",
      "english": "Noun Cases",
      "category": "格",
      "cefr": "A2",
      "formula": "名词 + 格词尾（-র/এর · -কে · -তে · -থেকে）",
      "summary": "孟加拉语名词靠词尾标示格：属格 -র/এর，宾格与与格 -কে，方位格 -তে，起点用 -থেকে。词尾选择与名词的有生性和语音结尾有关。",
      "sections": [
        {
          "heading": "属格",
          "body": "属格相当于「的」：元音结尾多加 -র（বাড়ি → বাড়ির），辅音结尾多加 -এর（ছাত্র → ছাত্রের）。",
          "bullets": [
            "বাড়ির সামনে",
            "ছাত্রের বই"
          ]
        },
        {
          "heading": "宾格与格",
          "body": "-কে 标记接受者，也可以标记定指的直接宾语，尤其指人时几乎必用。"
        },
        {
          "heading": "方位格",
          "body": "-তে 表示「在……里/上」，-থেকে 表示「从……」，两者常与地点、时间名词搭配。"
        }
      ],
      "examples": [
        {
          "source": "ছেলেটি বাড়ির সামনে দাঁড়িয়ে আছে।",
          "translation": "那个男孩站在房子前面。"
        },
        {
          "source": "শিক্ষক ছাত্রকে একটি প্রশ্ন করলেন।",
          "translation": "老师问了学生一个问题。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "ছাত্রর বই",
          "right": "ছাত্রের বই",
          "why": "ছাত্র 以辅音结尾，属格用 -এর。"
        },
        {
          "wrong": "বাড়িএর সামনে",
          "right": "বাড়ির সামনে",
          "why": "বাড়ি 以元音符号 ি 结尾，属格直接加 -র。"
        }
      ],
      "related": [
        "bn-word-order",
        "bn-verb"
      ],
      "links": [
        {
          "label": "Wikipedia · Bengali grammar",
          "url": "https://en.wikipedia.org/wiki/Bengali_grammar",
