    {
      "id": "ur-verb",
      "language": "ur",
      "title": "动词变位",
      "english": "Verb Conjugation",
      "category": "动词",
      "cefr": "A2",
      "formula": "词根 + 体词尾（تا/تی/تے、رہا/رہی/رہے）+ 助动词（ہوں/ہو/ہے/ہیں）",
      "summary": "乌尔都语动词随人称、数和性变化。惯常体用 -تا/-تی/-تے 加 ہونا，进行体用 رہا/رہی/رہے，完成体用过去分词加助动词。",
      "sections": [
        {
          "heading": "惯常体",
          "body": "词根加 تا/تی/تے 再接 ہوں、ہو、ہے、ہیں，词尾元音跟主语的性数一致。",
          "bullets": [
            "میں پڑھتا ہوں۔",
            "وہ پڑھتی ہے۔",
            "وہ پڑھتے ہیں۔"
          ]
        },
        {
          "heading": "进行体",
          "body": "词根加 رہا/رہی/رہے 再接助动词，表示正在进行的动作。"
        },
        {
          "heading": "完成体",
          "body": "用过去分词加 ہے/ہیں；及物动词完成体的主语要加 نے，动词随宾语变化。",
          "bullets": [
            "اس نے کھانا کھایا۔",
            "اس نے چائے پی۔"
          ]
        }
      ],
      "examples": [
        {
          "source": "میں ہر روز اردو سیکھتا ہوں۔",
          "translation": "我每天学乌尔都语。"
        },
        {
          "source": "وہ ابھی کھانا کھا رہا ہے۔",
          "translation": "他现在正在吃饭。"
        }
      ],
      "pitfalls": [
        {
