{
  "entries": [
    {
      "id": "hi-word-order",
      "language": "hi",
      "title": "动词居末的语序",
      "english": "SOV Word Order",
      "category": "语序",
      "cefr": "A1",
      "formula": "主语 + 宾语 + 动词（SOV）",
      "summary": "印地语的动词固定在句末，基本语序是主—宾—动。格关系由后置词和词尾承担，所以成分可以前移，但动词始终收尾。",
      "sections": [
        {
          "heading": "基本语序",
          "body": "主语在最前，宾语居中，动词放在最后；形容词、属格等修饰语都排在中心词之前。",
          "bullets": [
            "मैं चाय पीता हूँ।",
            "वह किताब पढ़ता है।"
          ]
        },
        {
          "heading": "疑问与否定",
          "body": "疑问词不搬到句首，而是留在原来的位置；否定词 नहीं 紧放在动词之前。"
        },
        {
          "heading": "语序调整",
          "body": "为了强调，宾语或状语可以提到句首，但动词仍然留在末尾，位置不受影响。"
        }
      ],
      "examples": [
        {
          "source": "मैं रोज़ सुबह चाय पीता हूँ।",
          "translation": "我每天早上喝茶。"
        },
        {
          "source": "उसने मुझे एक नई किताब दी।",
          "translation": "他给了我一本新书。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "मैं पीता हूँ चाय।",
          "right": "मैं चाय पीता हूँ।",
          "why": "印地语动词必须收尾，宾语不能跑到动词后面。"
        },
        {
          "wrong": "कहाँ तुम रहते हो?",
          "right": "तुम कहाँ रहते हो?",
          "why": "疑问词留在原位，不必像英语那样提前。"
        }
      ],
      "related": [
        "hi-postpositions",
        "hi-verb"
      ],
      "links": [
        {
          "label": "Wikipedia · Hindustani grammar",
          "url": "https://en.wikipedia.org/wiki/Hindustani_grammar",
          "site": "Wikipedia"
        },
        {
          "label": "HindiPod101",
          "url": "https://www.hindipod101.com/",
          "site": "HindiPod101"
        }
      ],
      "patterns": [
        "मैं\\s+[^\\n]{1,40}हूँ",
        "(पीता|पीती|पीते)\\s+हूँ",
        "उसने\\s+[^\\n]{1,30}दी",
        "\\b(?:मैं|हम|तुम|आप|वह|वे|यह|ये)\\b[^।]{0,80}\\b(?:हूँ|हैं|है|था|थी|थे)\\b"
      ],
      "sample": "मैं रोज़ सुबह चाय पीता हूँ।",
      "priority": 6,
      "confidence": 0.86
    },
    {
      "id": "hi-postpositions",
      "language": "hi",
      "title": "后置词系统",
      "english": "Postpositions",
      "category": "后置词",
      "cefr": "A1",
      "formula": "名词 + का/की/के · को · में · से · पर",
      "summary": "印地语不用介词，而用放在名词之后的后置词。का/की/के 表领属并与中心名词的性数一致，को 标记定指宾语或接受者。",
      "sections": [
        {
          "heading": "领属后置词",
          "body": "का、की、के 相当于「的」，形式随被领属的中心名词变化：阳性 का、阴性 की、复数或斜格 के。",
          "bullets": [
            "मेरा भाई",
            "मेरी बहन",
            "मेरे दोस्त"
          ]
        },
        {
          "heading": "格标记",
          "body": "को 标记接受者或定指宾语，में 表示「在里面」，पर 表示「在上面」，से 表示来源或工具。"
        },
        {
          "heading": "代词斜格",
          "body": "后置词前的代词要用斜格形式：मैं 变 मुझ，वह 变 उस，यह 变 इस。"
        }
      ],
      "examples": [
        {
          "source": "यह मेरी बहन की किताब है।",
          "translation": "这是我姐姐的书。"
        },
        {
          "source": "बच्चे बगीचे में खेल रहे हैं।",
          "translation": "孩子们在花园里玩。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "यह मेरा बहन की किताब है।",
          "right": "यह मेरी बहन की किताब है।",
          "why": "बहन 是阴性名词，领属词要用 मेरी、की。"
        },
        {
          "wrong": "मैं स्कूल में जा रहा हूँ।",
          "right": "मैं स्कूल जा रहा हूँ।",
          "why": "表示去某地不用 में，में 只表「在……里」。"
        }
      ],
      "related": [
        "hi-word-order",
        "hi-gender"
      ],
      "links": [
        {
          "label": "Wikipedia · Hindustani grammar",
          "url": "https://en.wikipedia.org/wiki/Hindustani_grammar",
          "site": "Wikipedia"
        },
        {
          "label": "HindiPod101",
          "url": "https://www.hindipod101.com/",
          "site": "HindiPod101"
        }
      ],
      "patterns": [
        "(का|की|के)\\s+[^\\s]+",
        "में\\s+[^\\s]+",
        "(मुझ|तुम|उस|इस)से",
        "\\b(?:का|की|के|को|में|से|पर|ने)\\b"
      ],
      "sample": "यह मेरी बहन की किताब है।",
      "priority": 6,
      "confidence": 0.85
    },
    {
      "id": "hi-gender",
      "language": "hi",
      "title": "名词的性与数",
      "english": "Gender and Number",
      "category": "名词",
      "cefr": "A1",
      "formula": "阳性 / 阴性 × 单数 / 复数 + 一致",
      "summary": "印地语名词分阳性和阴性，形容词、分词和动词都要与名词的性数一致。词尾 -ा 多为阳性、-ी 多为阴性，但存在不少例外。",
      "sections": [
        {
          "heading": "性别判定",
          "body": "以 -ा 结尾的名词多为阳性，以 -ी 结尾的多为阴性；但像 पानी 是阳性、किताब 是阴性，需要逐个记。"
        },
        {
          "heading": "数与一致",
          "body": "阳性 -ा 在复数变 -े（लड़का → लड़के），阴性 -ी 常变 -ियाँ（लड़की → लड़कियाँ）。"
        },
        {
          "heading": "动词一致",
          "body": "形容词和动词分词也要跟着变：阳性 अच्छा、阴性 अच्छी、复数 अच्छे。",
          "bullets": [
            "लड़का अच्छा है।",
            "लड़की अच्छी है।"
          ]
        }
      ],
      "examples": [
        {
          "source": "यह लड़का बहुत अच्छा गाता है।",
          "translation": "这个男孩唱得很好。"
        },
        {
          "source": "उसकी दो बहनें हैं।",
          "translation": "他有两个姐妹。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "लड़की अच्छा है।",
          "right": "लड़की अच्छी है।",
          "why": "लड़की 是阴性，形容词用 अच्छी。"
        },
        {
          "wrong": "मेरा किताब",
          "right": "मेरी किताब",
          "why": "किताब 是阴性，领属词用 मेरी。"
        }
      ],
      "related": [
        "hi-postpositions",
        "hi-verb"
      ],
      "links": [
        {
          "label": "Wikipedia · Hindustani grammar",
          "url": "https://en.wikipedia.org/wiki/Hindustani_grammar",
          "site": "Wikipedia"
        },
        {
          "label": "HindiPod101",
          "url": "https://www.hindipod101.com/",
          "site": "HindiPod101"
        }
      ],
      "patterns": [
        "अच्छी\\s+है",
        "बहनें\\s+हैं",
        "(लड़का|लड़की)\\s+[^\\n]{0,15}है",
        "\\b(?:अच्छा|अच्छी|बड़ा|बड़ी|छोटा|छोटी|नया|नई)\\b"
      ],
      "sample": "उसकी दो बहनें हैं।",
      "priority": 5,
      "confidence": 0.85
    },
    {
      "id": "hi-verb",
      "language": "hi",
      "title": "动词变位",
      "english": "Verb Conjugation",
      "category": "动词",
      "cefr": "A2",
      "formula": "词根 + 体词尾（ता/ती/ते、रहा/रही/रहे）+ 助动词（हूँ/हो/है/हैं）",
      "summary": "印地语动词随人称、数和性变化。惯常体用 -ता/-ती/-ते 加 होना，进行体用 रहा/रही/रहे，完成体用过去分词加助动词。",
      "sections": [
        {
          "heading": "惯常现在时",
          "body": "词根加 ता/ती/ते，再接 हूँ、हो、है、हैं；词尾的元音要跟主语的性数一致。",
          "bullets": [
            "मैं पढ़ता हूँ।",
            "वह पढ़ती है।",
            "वे पढ़ते हैं।"
          ]
        },
        {
          "heading": "进行体",
          "body": "词根加 रहा/रही/रहे 再接助动词，表示正在进行的动作。"
        },
        {
          "heading": "完成体",
          "body": "用过去分词加 है/हैं；及物动词的完成体主语要加 ने，动词随宾语变化。",
          "bullets": [
            "उसने खाना खाया।",
            "उसने चाय पी।"
          ]
        }
      ],
      "examples": [
        {
          "source": "मैं हर दिन हिन्दी पढ़ता हूँ।",
          "translation": "我每天学印地语。"
        },
        {
          "source": "वे अभी खाना खा रहे हैं।",
          "translation": "他们正在吃饭。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "मैं पढ़ता है।",
          "right": "मैं पढ़ता हूँ।",
          "why": "第一人称单数用 हूँ，不是 है。"
        },
        {
          "wrong": "वह खाना खाया।",
          "right": "उसने खाना खाया।",
          "why": "及物动词完成体主语要加 ने。"
        }
      ],
      "related": [
        "hi-word-order",
        "hi-compound-verbs"
      ],
      "links": [
        {
          "label": "Wikipedia · Hindustani grammar",
          "url": "https://en.wikipedia.org/wiki/Hindustani_grammar",
          "site": "Wikipedia"
        },
        {
          "label": "HindiPod101",
          "url": "https://www.hindipod101.com/",
          "site": "HindiPod101"
        }
      ],
      "patterns": [
        "(रहा|रही|रहे)\\s+(है|हैं|हो)",
        "(ता|ती|ते)\\s+हूँ",
        "ने\\s+[^\\n]{1,25}(दिया|ली|खाया|पी)",
        "\\b(?:रहा|रही|रहे|ता|ती|ते|या|यी|ये)\\b"
      ],
      "sample": "वे अभी खाना खा रहे हैं।",
      "priority": 6,
      "confidence": 0.85
    },
    {
      "id": "hi-compound-verbs",
      "language": "hi",
      "title": "复合动词",
      "english": "Compound Verbs",
      "category": "动词",
      "cefr": "B1",
      "formula": "主要动词词根 + 轻动词（जाना / देना / लेना / डालना…）",
      "summary": "印地语常用「主要动词 + 轻动词」构成复合动词，第二个动词不表实义，而表示完成、受益、方向或突然等体貌意义。",
      "sections": [
        {
          "heading": "常见组合",
          "body": "कर देना 表示「做完、为别人做」，कर लेना 表示「为自己做」，कर जाना 表示动作持续下去或彻底完成。",
          "bullets": [
            "कर देना",
            "कर लेना",
            "कर जाना"
          ]
        },
        {
          "heading": "意义变化",
          "body": "第二个动词虚化后不再表示「给、拿、去」的本义，只承担体貌或态度色彩。"
        },
        {
          "heading": "形式规则",
          "body": "前一个动词用词根形式，不加 -या/-ई；性数一致只体现在轻动词上。"
        }
      ],
      "examples": [
        {
          "source": "मैंने सारा काम कर दिया।",
          "translation": "我把所有活儿都干完了。"
        },
        {
          "source": "उसने पूरी कहानी सुन ली।",
          "translation": "他把整个故事都听完了。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "मैंने काम किया दिया।",
          "right": "मैंने काम कर दिया।",
          "why": "复合动词的第一个动词用词根，不再带过去分词词尾。"
        },
        {
          "wrong": "उसने कहानी सुना ली।",
          "right": "उसने कहानी सुन ली।",
          "why": "主要动词保持词根 सुन，性数只由 लेना 变成 ली 体现。"
        }
      ],
      "related": [
        "hi-verb",
        "hi-gender"
      ],
      "links": [
        {
          "label": "Wikipedia · Hindustani grammar",
          "url": "https://en.wikipedia.org/wiki/Hindustani_grammar",
          "site": "Wikipedia"
        },
        {
          "label": "HindiPod101",
          "url": "https://www.hindipod101.com/",
          "site": "HindiPod101"
        }
      ],
      "patterns": [
        "कर\\s+(दिया|देना|लिया|लेना)",
        "सुन\\s+ली",
        "(दिया|ली)\\s*[।]",
        "\\b(?:कर|दे|ले|जा|आ)\\s+(?:दिया|देना|लिया|लेना|गया|गई|आया|आई)\\b"
      ],
      "sample": "उसने पूरी कहानी सुन ली।",
      "priority": 4,
      "confidence": 0.82
    },
    {
      "id": "bn-word-order",
      "language": "bn",
      "title": "动词居末的语序",
      "english": "SOV Word Order",
      "category": "语序",
      "cefr": "A1",
      "formula": "主语 + 宾语 + 动词（SOV）",
      "summary": "孟加拉语的动词固定在句末，基本语序为 SOV。格关系和后置词承担了语法角色，因此成分可以因话题化而前移。",
      "sections": [
        {
          "heading": "基本语序",
          "body": "主语在前，宾语居中，动词收尾；形容词、属格修饰语都放在中心词之前。",
          "bullets": [
            "আমি ভাত খাই।",
            "সে বই পড়ে।"
          ]
        },
        {
          "heading": "疑问句",
          "body": "疑问词留在原位，句末加疑问语气词 কি，语序基本不变。"
        },
        {
          "heading": "话题移位",
          "body": "要强调的成分可以提到句首，但动词仍然留在最后。"
        }
      ],
      "examples": [
        {
          "source": "আমি প্রতিদিন বাংলা পড়ি।",
          "translation": "我每天学孟加拉语。"
        },
        {
          "source": "সে আমাকে একটি বই দিয়েছে।",
          "translation": "他给了我一本书。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "আমি পড়ি বাংলা।",
          "right": "আমি বাংলা পড়ি।",
          "why": "动词必须收尾，宾语不能放在动词之后。"
        },
        {
          "wrong": "সে দিয়েছে আমাকে একটি বই।",
          "right": "সে আমাকে একটি বই দিয়েছে।",
          "why": "动词居末，间接宾语和直接宾语都在它前面。"
        }
      ],
      "related": [
        "bn-cases",
        "bn-verb"
      ],
      "links": [
        {
          "label": "Wikipedia · Bengali grammar",
          "url": "https://en.wikipedia.org/wiki/Bengali_grammar",
          "site": "Wikipedia"
        },
        {
          "label": "BengaliPod101",
          "url": "https://www.bengalipod101.com/",
          "site": "BengaliPod101"
        }
      ],
      "patterns": [
        "পড়ি\\s*[।]",
        "দিয়েছে\\s*[।]",
        "(আমি|সে)\\s+[^\\n]{1,25}পড়ি",
        "\\b(?:আমি|আমরা|তুমি|আপনি|সে|তারা)\\b[^।]{0,80}\\b(?:হই|হইছি|হয়|হয়েছে|ছিল|ছিলেন)\\b"
      ],
      "sample": "আমি প্রতিদিন বাংলা পড়ি।",
