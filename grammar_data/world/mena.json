      "cefr": "A1",
      "formula": "词干 + -i（宾格）/ -e（与格）/ -de（位格）/ -den（从格）/ -in（属格）",
      "summary": "土耳其语用后缀表示六个格：主格零形式、宾格 -ı、与格 -e、位格 -da、从格 -dan、属格 -ın。后缀随元音和谐变化。",
      "sections": [
        {
          "heading": "六个格",
          "body": "主格无标记，其余各格用一个后缀表示语法关系或方向。",
          "bullets": [
            "kitap 书（主格）",
            "kitabı 把书",
            "kitaba 向书",
            "kitapta 在书里",
            "kitaptan 从书里",
            "kitabın 书的"
          ]
        },
        {
          "heading": "缓冲辅音",
          "body": "元音结尾的名词要加 y 或 n 作缓冲。",
          "bullets": [
            "araba → arabayı 把车",
            "araba → arabanın 车的"
          ]
        },
        {
          "heading": "辅音同化",
          "body": "清辅音后用 -ta/-te、-tan/-ten。",
          "bullets": [
            "sokakta 在街上",
            "sokaktan 从街上"
          ]
        }
      ],
      "examples": [
        {
          "source": "Kitabı masaya koydum.",
          "translation": "我把书放在桌子上了。"
        },
