    {
      "id": "fa-verb",
      "language": "fa",
      "title": "动词变位",
      "english": "Verb Conjugation",
      "category": "动词",
      "cefr": "A1",
      "formula": "词干 + 人称词尾：-am / -i / -ad / -im / -id / -and",
      "summary": "波斯语动词由词干加人称词尾构成：现在时用现在词干，过去时用过去词干；第三人称单数过去式不加词尾。",
      "sections": [
        {
          "heading": "现在时",
          "body": "现在词干加词尾 -am/-i/-ad/-im/-id/-and，常带 می 表示进行或习惯。",
          "bullets": [
            "میروم 我去",
            "میروند 他们去"
          ]
        },
        {
          "heading": "过去时",
          "body": "过去词干加同样的词尾，但第三人称单数不加词尾。",
          "bullets": [
            "رفتم 我去了",
            "رفت 他去了"
          ]
        },
        {
          "heading": "不规则词干",
          "body": "有些动词的现在词干和不定式差别很大，需要单独记。",
          "bullets": [
            "رفتن → رو",
            "گفتن → گو"
          ]
        }
      ],
      "examples": [
        {
          "source": "من فارسی یاد میگیرم.",
          "translation": "我在学波斯语。"
        },
        {
          "source": "دیروز به بازار رفتم.",
          "translation": "昨天我去了市场。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "من دیروز به بازار میروم.",
          "right": "من دیروز به بازار رفتم.",
          "why": "دیروز 指明过去，动词要用过去词干。"
        },
        {
          "wrong": "او رفتند.",
          "right": "او رفت.",
          "why": "第三人称单数过去式不加人称词尾，-ند 是复数形式。"
        }
      ],
