    {
      "id": "he-binyan",
      "language": "he",
      "title": "动词模板",
      "english": "Binyan Verb Patterns",
      "category": "动词",
      "cefr": "A2",
      "formula": "词根（שורש）+ 七个 בניין 模板",
      "summary": "希伯来语动词由三辅音词根套进七个 בניין 模板构成，模板决定主动、被动、使役或反身等意义。",
      "sections": [
        {
          "heading": "七个模板",
          "body": "פעל、נפעל、פיעל、פועל、הפעיל、הופעל、התפעל，各有固定的元音和前后缀模式。",
          "bullets": [
            "כתב 写（פעל）",
            "הכתיב 口述（הפעיל）",
            "התכתב 通信（התפעל）"
          ]
        },
        {
          "heading": "语态配对",
          "body": "פעל 的被动是 נפעל，פיעל 的被动是 פועל，הפעיל 的被动是 הופעל。"
        },
        {
          "heading": "词根识别",
          "body": "同一词根进入不同模板，意义相关但不同，所以记词要把词根和模板一起记。"
        }
      ],
      "examples": [
        {
          "source": "המורה הסביר את השיעור.",
          "translation": "老师讲解了这一课。"
        },
        {
          "source": "הדלת נסגרה בשמונה בערב.",
          "translation": "门在晚上八点关上了。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "以为一个词根只对应一个动词",
          "right": "同一词根可进多个模板：כתב / הכתיב / התכתב",
          "why": "模板改变语态和语义，只记词根会漏掉关键的语态信息。"
        },
        {
          "wrong": "הדלת סגרה.",
          "right": "הדלת נסגרה.",
          "why": "“门被关上”用 נפעל 的 נסגרה；סגרה 是主动的“她关了”。"
        }
      ],
