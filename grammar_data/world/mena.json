    {
      "id": "tr-vowel-harmony",
      "language": "tr",
      "title": "元音和谐",
      "english": "Vowel Harmony",
      "category": "构词",
      "cefr": "A1",
      "formula": "后元音 a ı o u → a；前元音 e i ö ü → e",
      "summary": "土耳其语后缀的元音必须与词干最后一个元音同类：后元音后接 a，前元音后接 e。四变体后缀还会区分圆唇与否。",
      "sections": [
        {
          "heading": "两元音和谐",
          "body": "后缀只在 a/e 之间选择，如 -lar/-ler、-da/-de、-dan/-den。",
          "bullets": [
            "kitaplar 书（复数）",
            "evler 房子（复数）",
            "evde 在家里"
          ]
        },
        {
          "heading": "四元音和谐",
          "body": "-ı/-i/-u/-ü 还要看词干末尾是否圆唇。",
          "bullets": [
            "yazı 文字",
            "evi 他的房子",
            "okulu 他的学校",
            "gözü 他的眼睛"
          ]
        },
        {
          "heading": "辅音同化",
          "body": "清辅音后 -da 变 -ta，-dan 变 -tan。",
          "bullets": [
            "kitapta 在书里",
            "sokakta 在街上"
          ]
        }
      ],
      "examples": [
        {
          "source": "Kitaplar masada duruyor.",
          "translation": "书在桌子上放着。"
        },
        {
          "source": "Evde kimse yok.",
          "translation": "家里没有人。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "kitablar",
          "right": "kitaplar",
          "why": "-lar 以辅音开头，词干末尾的 p 不浊化，直接写 kitaplar。"
        },
        {
          "wrong": "evlar",
          "right": "evler",
          "why": "ev 是前元音词干，复数后缀要用 -ler。"
        }
      ],
      "related": [
        "tr-cases",
        "tr-relative"
      ],
