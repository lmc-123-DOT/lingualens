          "source": "Ankara'dan İstanbul'a gidiyorum.",
          "translation": "我正从安卡拉去伊斯坦布尔。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "Kitap masaya koydum.",
          "right": "Kitabı masaya koydum.",
          "why": "确定的直接宾语必须带宾格 -ı，词干末尾 p 在元音前浊化为 b。"
        },
        {
          "wrong": "Ankaradan geliyorum.",
          "right": "Ankara'dan geliyorum.",
          "why": "专有名词加格后缀时要用撇号隔开。"
        }
      ],
