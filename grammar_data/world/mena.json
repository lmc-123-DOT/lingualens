    {
      "id": "fa-ezafe",
      "language": "fa",
      "title": "伊扎菲",
      "english": "Ezafe Construction",
      "category": "助词",
      "cefr": "A1",
      "formula": "名词 + -e（元音后作 -ye）+ 修饰语",
      "summary": "伊扎菲是连接名词与形容词、所属语或同位语的短元音 -e，日常书写常省略不写。以元音结尾的名词要加 -ye。",
      "sections": [
        {
          "heading": "连接作用",
          "body": "名词和后面的形容词、所属语之间必须有 ezafe，读作短元音 -e。",
          "bullets": [
            "کتابِ نو 新书",
            "دوستِ من 我的朋友"
          ]
        },
        {
          "heading": "元音后变体",
          "body": "名词以 ه 或 ا、و 结尾时，ezafe 写作 -ye。",
          "bullets": [
            "خانهی بزرگ 大房子",
            "دریای آبی 蓝色的海"
          ]
        },
        {
          "heading": "省略写法",
          "body": "现代书面语通常不标出 ezafe，只靠语序判断；朗读时必须补出来。"
        }
      ],
      "examples": [
        {
          "source": "دوست من در شیراز زندگی میکند.",
          "translation": "我的朋友住在设拉子。"
        },
        {
          "source": "خانهی ما نزدیک پارک است.",
          "translation": "我们家离公园很近。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "خانه بزرگ 读作 khāne bozorg",
          "right": "خانهی بزرگ 读作 khāne-ye bozorg",
          "why": "以元音结尾的名词必须加 -ye 才能连接后面的修饰语。"
        },
        {
          "wrong": "دوستم خانه（想说“我朋友的家”）",
          "right": "خانهی دوستم",
          "why": "所属结构是“被拥有物 + ezafe + 拥有者”，顺序和汉语相反。"
        }
      ],
      "related": [
        "fa-word-order",
        "fa-ra"
      ],
      "links": [
