{
  "entries": [
    {
      "id": "ar-root",
      "language": "ar",
      "title": "三辅音词根",
      "english": "Triconsonantal Root System",
      "category": "构词",
      "cefr": "A2",
      "formula": "词根（جذر）+ 模板（وزن）→ 派生词族",
      "summary": "阿拉伯语多数词由三个辅音组成的词根派生，词根只承载核心语义，模板决定词性与语法功能。记住一个词根的常见派生形，就能成串记词。",
      "sections": [
        {
          "heading": "词根",
          "body": "词根只写辅音，如 ك-ت-ب 表示“书写”。同一词根可派生出动词、名词、形容词和地点名词。",
          "bullets": [
            "كَتَبَ 写",
            "كِتَاب 书",
            "كَاتِب 作家",
            "مَكْتَبَة 图书馆"
          ]
        },
        {
          "heading": "模板",
          "body": "模板（وزن）是带元音和前后缀的框架，把词根辅音填进去就得到具体的词。",
          "bullets": [
            "فَاعِل → كَاتِب",
            "مَفْعَلَة → مَكْتَبَة"
          ]
        },
        {
          "heading": "记忆方法",
          "body": "按词根成组记词，比按字母背词表高效；遇到生词先找出三辅音骨架，再判断它套的是哪个模板。"
        }
      ],
      "examples": [
        {
          "source": "يكتب الطالب الدرس كل صباح.",
          "translation": "学生每天早上写这一课的作业。"
        },
        {
          "source": "هذه المكتبة قريبة من الجامعة.",
          "translation": "这座图书馆离大学很近。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "把 كِتَاب 当成孤立单词死记",
          "right": "以 ك-ت-ب 为词根，串记 كَاتِب、مَكْتَبَة、مَكْتُوب",
          "why": "阿拉伯语词汇以词根词族为单位组织，孤立记词会让记忆量成倍增加。"
        },
        {
          "wrong": "以为同一词根派生出的词元音都相同",
          "right": "辅音骨架不变，元音由模板决定：كَتَبَ / كِتَاب / كَاتِب",
          "why": "元音属于模板而不属于词根，这正是派生系统的关键。"
        }
      ],
      "related": [
        "ar-verb-forms",
        "ar-nominal"
      ],
      "links": [
        {
          "label": "Wikipedia · Semitic root",
          "url": "https://en.wikipedia.org/wiki/Semitic_root",
          "site": "Wikipedia"
        },
        {
          "label": "Madinah Arabic · 词根与派生",
          "url": "https://www.madinaharabic.com/",
          "site": "Madinah Arabic"
        }
      ],
      "patterns": [
        "(?:^|\\s)(?:ي|ت|ن|أ)?كتب\\w*",
        "مكتب(?:ة)?|كاتب"
      ],
      "sample": "يكتب الطالب الدرس كل صباح.",
      "priority": 5,
      "confidence": 0.84
    },
    {
      "id": "ar-cases",
      "language": "ar",
      "title": "格与格尾",
      "english": "Case Endings (I'rab)",
      "category": "格",
      "cefr": "B1",
      "formula": "名词/形容词 + ـُ（主格）/ ـَ（宾格）/ ـِ（属格）",
      "summary": "书面阿拉伯语用词尾短元音标示名词在句中的语法格：主格 -u、宾格 -a、属格 -i。口语中这些格尾通常不读出来。",
      "sections": [
        {
          "heading": "三种格",
          "body": "主格标记主语和名词句的谓语，宾格标记直接宾语，属格出现在介词之后和所属结构里。",
          "bullets": [
            "الطالبُ（主格）",
            "الكتابَ（宾格）",
            "المكتبةِ（属格）"
          ]
        },
        {
          "heading": "不定名词",
          "body": "不定名词用 -un/-an/-in 的鼻音化词尾（تنوين），拼写作 ـٌ、ـًا、ـٍ。",
          "bullets": [
            "كتابٌ 一本书（主格）",
            "كتابًا 一本书（宾格）"
          ]
        },
        {
          "heading": "口语差异",
          "body": "现代口语基本不读格尾，靠语序和介词表达同样的关系；格尾主要是阅读书面语时的工具。"
        }
      ],
      "examples": [
        {
          "source": "قرأ الطالبُ الكتابَ في المكتبةِ.",
          "translation": "学生在图书馆里读完了这本书。"
        },
        {
          "source": "سلّمتُ الرسالةَ إلى المديرِ.",
          "translation": "我把信交给了经理。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "قرأ الطالب الكتاب في المكتبةَ.",
          "right": "قرأ الطالبُ الكتابَ في المكتبةِ.",
          "why": "主语用主格 -u，直接宾语用宾格 -a，介词 في 后的名词用属格 -i。"
        },
        {
          "wrong": "في المكتبةُ",
          "right": "في المكتبةِ",
          "why": "介词支配属格，与名词是不是“话题”无关。"
        }
      ],
      "related": [
        "ar-nominal",
        "ar-article"
      ],
      "links": [
        {
          "label": "Wikipedia · Arabic grammar",
          "url": "https://en.wikipedia.org/wiki/Arabic_grammar",
          "site": "Wikipedia"
        },
        {
          "label": "ArabicPod101 · 语法课程",
          "url": "https://www.arabicpod101.com/",
          "site": "ArabicPod101"
        }
      ],
      "patterns": [
        "[\\u0621-\\u064a]ً",
        "[\\u0621-\\u064a][ُِ]\\s",
        "(?:^|\\s)(?:في|من|إلى|على|عن|مع)\\s"
      ],
      "sample": "قرأ الطالبُ الكتابَ في المكتبةِ.",
      "priority": 4,
      "confidence": 0.82
    },
    {
      "id": "ar-article",
      "language": "ar",
      "title": "定冠词 ال",
      "english": "The Definite Article al-",
      "category": "限定词",
      "cefr": "A1",
      "formula": "ال + 名词（太阳字母同化，月亮字母保留 l）",
      "summary": "ال 加在名词前表示定指，相当于英语 the。遇到太阳字母时 l 不发音、后辅音加重读；遇到月亮字母则正常读 l。",
      "sections": [
        {
          "heading": "定指功能",
          "body": "ال 让名词变成已知或特定的事物，修饰它的形容词也要跟着加 ال。",
          "bullets": [
            "بيت 一座房子 → البيت 那座房子",
            "البيت الجديد 那座新房子"
          ]
        },
        {
          "heading": "太阳字母",
          "body": "ت ث د ذ ر ز س ش ص ض ط ظ ل ن 是太阳字母，ال 的 l 被同化，الشمس 读作 ash-shams 而不是 al-shams。"
        },
        {
          "heading": "连写",
          "body": "ال 与前接的介词连写：بِ + ال = بال，لِ + ال = لل；与 في 这类词则分开写。",
          "bullets": [
            "بالبيت 在那座房子里",
            "للمدرسة 给那所学校"
          ]
        }
      ],
      "examples": [
        {
          "source": "البيت قريب من المدرسة.",
          "translation": "那座房子离学校很近。"
        },
        {
          "source": "الشمس مشرقة هذا الصباح.",
          "translation": "今天早上阳光明媚。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "把 الشمس 读成 al-shams",
          "right": "读成 ash-shams，ل 被 ش 同化",
          "why": "ش 是太阳字母，ال 的 l 不发音，后面的辅音要加重。"
        },
        {
          "wrong": "بيت الجديد",
          "right": "البيت الجديد",
          "why": "名词定指时，修饰它的形容词也必须加定冠词。"
        }
      ],
      "related": [
        "ar-nominal",
        "ar-cases"
      ],
      "links": [
        {
          "label": "Wikipedia · Arabic definite article",
          "url": "https://en.wikipedia.org/wiki/Arabic_definite_article",
          "site": "Wikipedia"
        },
        {
          "label": "Madinah Arabic · 冠词与名词",
          "url": "https://www.madinaharabic.com/",
          "site": "Madinah Arabic"
        }
      ],
      "patterns": [
        "\\bال[\\u0600-\\u06ff]+"
      ],
      "sample": "البيت قريب من المدرسة.",
      "priority": 6,
      "confidence": 0.87
    },
    {
      "id": "ar-verb-forms",
      "language": "ar",
      "title": "动词变位",
      "english": "Verb Conjugation",
      "category": "动词",
      "cefr": "A2",
      "formula": "过去式：词干 + 后缀；现在式：前缀（أ/ت/ي/ن）+ 词干 + 后缀",
      "summary": "阿拉伯语动词随人称、性和数变化。过去式主要靠后缀区分人称，现在式则用前缀加后缀，阴性复数非人类主语还要用单数动词。",
      "sections": [
        {
          "heading": "过去式",
          "body": "在词干后加后缀区分人称：-تُ（我）、-تَ（你，阳）、-تِ（你，阴）、-َ（他）、-َتْ（她）。",
          "bullets": [
            "كتبتُ 我写了",
            "كتبوا 他们写了"
          ]
        },
        {
          "heading": "现在式",
          "body": "用前缀 أ/ت/ي/ن 加词干，再加 -ُ、-ين、-ون 等后缀。",
          "bullets": [
            "أكتب 我写",
            "تكتب 你写",
            "يكتبون 他们写"
          ]
        },
        {
          "heading": "一致规则",
          "body": "主语是阴性复数且指非人类时，动词用阴性单数形式。",
          "bullets": [
            "الكتبُ وصلت 书到了"
          ]
        }
      ],
      "examples": [
        {
          "source": "أكتب رسالة إلى صديقي كل مساء.",
          "translation": "我每天晚上给朋友写一封信。"
        },
        {
          "source": "كتبوا التقرير قبل نهاية الأسبوع.",
          "translation": "他们在周末前写完了报告。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "هي كتبوا الدرس.",
          "right": "هي كتبت الدرس.",
          "why": "单数阴性主语用 -َتْ，不能用复数后缀 -وا。"
        },
        {
          "wrong": "أنت تكتبين（对男性说）",
          "right": "أنت تكتب（对男性说）",
          "why": "第二人称阳性单数现在式不加 -ين，那是阴性形式。"
        }
      ],
      "related": [
        "ar-root",
        "ar-nominal"
      ],
      "links": [
        {
          "label": "Wikipedia · Arabic verbs",
          "url": "https://en.wikipedia.org/wiki/Arabic_verbs",
          "site": "Wikipedia"
        },
        {
          "label": "ArabicPod101 · 动词变位",
          "url": "https://www.arabicpod101.com/",
          "site": "ArabicPod101"
        }
      ],
      "patterns": [
        "(?:^|\\s)(?:أ|ت|ي|ن)كتب",
        "كتب(?:ت|وا|نا|تَ)",
        "\\b(?:كتب|قرأ|ذهب|قال|كان|صار|عمل)\\w*\\b"
      ],
      "sample": "أكتب رسالة إلى صديقي كل مساء.",
      "priority": 6,
      "confidence": 0.85
    },
    {
      "id": "ar-nominal",
      "language": "ar",
      "title": "名词句",
      "english": "Nominal Sentence (Jumla Ismiyya)",
      "category": "句式",
      "cefr": "A1",
      "formula": "مبتدأ（主格）+ خبر（主格），现在时无系动词",
      "summary": "以名词开头的句子叫名词句，主语和谓语都用主格，现在时不用“是”。要表达过去就加 كان，否定用 ليس。",
      "sections": [
        {
          "heading": "基本结构",
          "body": "主语在前、谓语在后，中间不加动词。",
          "bullets": [
            "الطقسُ جميلٌ 天气很好",
            "هو طالبٌ 他是学生"
          ]
        },
        {
          "heading": "谓语类型",
          "body": "谓语可以是形容词、名词或介词短语，也可以是一个完整的句子。"
        },
        {
          "heading": "过去与否定",
          "body": "加 كان 表过去，其谓语用宾格；否定用 ليس，谓语同样用宾格。",
          "bullets": [
            "كان الطقسُ جميلًا 天气曾经很好",
            "ليس الطقسُ جميلًا 天气不好"
          ]
        }
      ],
      "examples": [
        {
          "source": "الطقس جميل هذا الصباح.",
          "translation": "今天早上天气很好。"
        },
        {
          "source": "هي طالبة مجتهدة في الجامعة.",
          "translation": "她是大学里一名用功的学生。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "الطقس هو جميل.",
          "right": "الطقس جميل.",
          "why": "谓语是形容词时，现在时名词句不加系动词，也不需要多余的 هو。"
        },
        {
          "wrong": "ليس الطقس جميلٌ.",
          "right": "ليس الطقس جميلًا.",
          "why": "ليس 的谓语要用宾格，形容词加 -a。"
        }
      ],
      "related": [
        "ar-cases",
        "ar-article"
      ],
      "links": [
        {
          "label": "Wikipedia · Arabic nouns and adjectives",
          "url": "https://en.wikipedia.org/wiki/Arabic_nouns_and_adjectives",
          "site": "Wikipedia"
        },
        {
          "label": "Madinah Arabic · 名词句",
          "url": "https://www.madinaharabic.com/",
          "site": "Madinah Arabic"
        }
      ],
      "patterns": [
        "[\\u0621-\\u064a]{3,}ٌ(?:\\s|$)",
        "(?:^|\\s)(?:هو|هي)\\s+[\\u0621-\\u064a]+ٌ",
        "\\b(?:هو|هي|هم|هن|أنا|أنت|نحن)\\b"
      ],
      "sample": "الطقسُ جميلٌ هذا الصباح.",
      "priority": 5,
      "confidence": 0.86
    },
    {
      "id": "fa-word-order",
      "language": "fa",
      "title": "语序",
      "english": "Word Order (SOV)",
      "category": "语序",
      "cefr": "A1",
      "formula": "主语 + 时间/地点 + 宾语 + 动词（SOV）",
      "summary": "波斯语基本语序是主宾谓，动词固定在句末并携带人称词尾。修饰语跟在被修饰的名词后面。",
      "sections": [
        {
          "heading": "基本语序",
          "body": "主语在前，宾语在后，动词收尾；时间和地点状语通常紧挨在动词之前。",
          "bullets": [
            "من هر روز کتاب میخوانم. 我每天读书。"
          ]
        },
        {
          "heading": "动词收尾",
          "body": "动词带人称词尾，所以主语常可省略：میروم 本身已经是“我去”。"
        },
        {
          "heading": "修饰语后置",
          "body": "形容词和所属语都跟在名词后。",
          "bullets": [
            "کتابِ خوب 好书",
            "خانهی من 我的家"
          ]
        }
      ],
      "examples": [
        {
          "source": "من هر روز کتاب میخوانم.",
          "translation": "我每天读书。"
        },
        {
          "source": "او در تهران زندگی میکند.",
          "translation": "他住在德黑兰。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "من میخوانم کتاب.",
          "right": "من کتاب میخوانم.",
          "why": "把宾语放在动词前是波斯语的无标记语序，动词后置会显得很不自然。"
        },
        {
          "wrong": "خوب کتاب",
          "right": "کتاب خوب",
          "why": "形容词修饰名词时必须后置，这点和汉语相反。"
        }
      ],
