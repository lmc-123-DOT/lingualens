    {
      "id": "tr-evidencial",
      "language": "tr",
      "title": "传闻过去 -miş",
      "english": "Evidential Past -miş",
      "category": "语气",
      "cefr": "B1",
      "formula": "词干 + -mış/-miş/-muş/-müş + 人称词尾",
      "summary": "-miş 表示说话人没有亲眼所见，而是听说或推断出来的过去；与表示亲眼目击的 -dı 形成对比。",
      "sections": [
        {
          "heading": "传闻",
          "body": "转述别人的话或消息时用 -miş。",
          "bullets": [
            "Ali gelmiş 听说阿里来了",
            "Duydum ki taşınmışlar 听说他们搬家了"
          ]
        },
        {
          "heading": "推断",
          "body": "根据迹象做出的推断也用 -miş。",
          "bullets": [
            "Hava soğumuş 看来天变冷了"
          ]
        },
        {
          "heading": "人称词尾",
          "body": "要加 -ım/-sın 等人称词尾，第三人称不加。",
          "bullets": [
            "gelmişim 听说我来了",
            "gelmişsin 听说你来了"
          ]
        }
      ],
      "examples": [
        {
          "source": "Ali dün eve gelmiş.",
          "translation": "听说阿里昨天回家了。"
        },
        {
          "source": "Hava çok soğumuş.",
          "translation": "天气好像冷了很多。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "Ali dün eve geldi.（转述别人的话）",
          "right": "Ali dün eve gelmiş.",
          "why": "转述未经目击的信息要用 -miş；-dı 表示自己亲眼所见。"
        },
        {
          "wrong": "Sen gelmiş.",
          "right": "Sen gelmişsin.",
          "why": "第二人称必须加 -sin 人称词尾。"
        }
      ],
