      "english": "Relative Clauses",
      "category": "从句",
      "cefr": "B1",
      "formula": "动词 + -dik/-acak + 人称词尾 + 名词",
      "summary": "土耳其语没有关系代词，用 -dik/-acak 加人称后缀构成形动词短语，直接放在名词前修饰它。",
      "sections": [
        {
          "heading": "构成",
          "body": "动词加 -dik/-acak 再加人称词尾，整个短语放在被修饰的名词之前。",
          "bullets": [
            "aldığım kitap 我买的书",
            "gelecek adam 要来的那个人"
          ]
        },
        {
          "heading": "宾语关系化",
          "body": "被关系化的成分在从句里省略，从句主语的属格保留。",
          "bullets": [
            "Ali'nin aldığı kitap 阿里买的那本书"
          ]
        },
        {
          "heading": "与英语对比",
          "body": "英语 the book that I bought 在土耳其语里是 aldığım kitap，修饰语和被修饰语的顺序正好相反。"
        }
      ],
      "examples": [
        {
          "source": "Dün aldığım kitap çok güzel.",
          "translation": "我昨天买的那本书很好看。"
        },
        {
          "source": "Sana söylediğim şeyi unutma.",
          "translation": "别忘了我跟你说过的事。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "kitap aldığım çok güzel",
          "right": "aldığım kitap çok güzel",
          "why": "形动词短语必须放在被修饰名词之前。"
        },
        {
          "wrong": "Ali aldığı kitap",
          "right": "Ali'nin aldığı kitap",
          "why": "关系从句的主语要用属格，动词带第三人称词尾 -ğı。"
        }
      ],
