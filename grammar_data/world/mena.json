    {
      "id": "tr-tense",
      "language": "tr",
      "title": "时态",
      "english": "Tense Suffixes",
      "category": "时态",
      "cefr": "A1",
      "formula": "词干 + -yor / -dı / -acak + 人称词尾",
      "summary": "土耳其语时态靠后缀叠加：现在进行时 -yor、过去时 -dı/-di、将来时 -acak/-ecek，最后再加人称词尾。",
      "sections": [
        {
          "heading": "现在进行",
          "body": "-yor 后面接人称词尾。",
          "bullets": [
            "içiyorum 我正在喝",
            "gidiyorsun 你正在去",
            "geliyor 他正在来"
          ]
        },
        {
          "heading": "过去时",
          "body": "-dı/-di/-du/-dü 后面接人称词尾。",
          "bullets": [
            "geldim 我来了",
            "gitti 他去了",
            "okuduk 我们读了"
          ]
        },
        {
          "heading": "将来时",
          "body": "-acak/-ecek，第三人称单数常缩短词尾。",
          "bullets": [
            "gideceğim 我将去",
            "gidecek 他将去",
            "gideceğiz 我们将去"
          ]
        }
      ],
      "examples": [
        {
          "source": "Her sabah kahve içiyorum.",
          "translation": "我每天早上喝咖啡。"
        },
        {
          "source": "Yarın sinemaya gideceğiz.",
          "translation": "明天我们要去看电影。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "Dün sinemaya gidiyorum.",
          "right": "Dün sinemaya gittim.",
          "why": "dün 指过去，动词要用过去时 -dı 并加第一人称词尾。"
        },
        {
          "wrong": "Yarın sinemaya gideceğim.（主语是 biz）",
          "right": "Yarın sinemaya gideceğiz.",
          "why": "主语 biz 时人称词尾是 -eceğiz，不是 -eceğim。"
        }
      ],
