    },
    {
      "id": "pl-gender",
      "language": "pl",
      "title": "名词的性、数、格",
      "english": "Polish Noun Gender, Number and Agreement",
      "category": "名词",
      "cefr": "A1",
      "formula": "阳性 / 阴性 / 中性 + 单数 / 复数；形容词与名词性数格一致",
      "summary": "波兰语名词分阳性、阴性、中性，复数里还区分阳性人称与其余。形容词、代词和数词都要与名词一致。",
      "sections": [
        {
          "heading": "三性",
          "body": "以辅音结尾的多为阳性，以 -a 结尾的多为阴性，以 -o、-e、-ę 结尾的多为中性。词尾只是线索，例外要单独记。",
          "bullets": [
            "dom（阳性）",
            "kobieta（阴性）",
            "okno（中性）"
          ]
        },
        {
          "heading": "复数",
          "body": "阳性人称复数用 -i / -y 和 ci 这一套，其余复数用 -e / -a 和 te。这条区分会一路影响到形容词和代词。",
          "bullets": [
            "ci nowi studenci",
            "te nowe książki"
          ]
        },
        {
          "heading": "一致",
          "body": "形容词和物主代词跟着名词变：nowy dom、nowa książka、nowe okno。数词 dwa 与阴性 dwie 也按性选择。"
        }
      ],
      "examples": [
        {
          "source": "Ci nowi studenci są z Ukrainy.",
          "translation": "这些新学生来自乌克兰。"
        },
        {
          "source": "Te nowe książki leżą na stole.",
          "translation": "这些新书放在桌上。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "Te nowi studenci.",
          "right": "Ci nowi studenci.",
          "why": "阳性人称复数要用 ci，不能用 te。"
        },
        {
          "wrong": "Nowa okno.",
          "right": "Nowe okno.",
          "why": "okno 是中性，形容词用 -e 词尾。"
        }
      ],
      "related": [
        "pl-cases",
        "pl-negation"
      ],
      "links": [
        {
          "label": "Polish grammar · Gender",
          "url": "https://en.wikipedia.org/wiki/Polish_grammar",
          "site": "Wikipedia"
        },
        {
          "label": "PolishPod101",
          "url": "https://www.polishpod101.com/",
          "site": "PolishPod101"
        }
      ],
      "patterns": [
        "\\b(nowy|nowa|nowe|stary|stara|stare|ciekawy|ciekawa|ciekawe)\\s+[a-złśżźćńóąę]+\\b",
        "\\b(ci|te)\\s+(nowi|nowe|starzy|stare)\\b"
      ],
      "sample": "Te nowe książki leżą na stole.",
