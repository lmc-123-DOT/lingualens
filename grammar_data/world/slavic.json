{
  "entries": [
    {
      "id": "ru-aspect",
      "language": "ru",
      "title": "动词体：完成体与未完成体",
      "english": "Russian Verbal Aspect",
      "category": "体",
      "cefr": "A2",
      "formula": "未完成体（НСВ）↔ 完成体（СВ）：前缀 про-/на-/с-/по- 或后缀 -ыва-/-ива-",
      "summary": "俄语动词几乎都以成对的形式出现。未完成体看过程与重复，完成体看结果与一次完成。",
      "sections": [
        {
          "heading": "体的对立",
          "body": "同一动作可以有两种看法：писать 是写的过程，написать 是写完的结果。词典里通常把两个形式分别列出。",
          "bullets": [
            "читать — прочитать",
            "писать — написать",
            "делать — сделать",
            "говорить — сказать"
          ]
        },
        {
          "heading": "构成方式",
          "body": "最常见的是加前缀，其次是用后缀替换词干，也有完全不同的异干对。前缀往往同时带来完成体的结果意味。",
          "bullets": [
            "前缀：писать → написать",
            "后缀：открывать → открыть",
            "异干：говорить → сказать"
          ]
        },
        {
          "heading": "使用场合",
          "body": "叙述事件顺序用完成体，描写背景、习惯和持续过程用未完成体。完成体没有复合将来时，它的现在时形式本身就表将来。"
        }
      ],
      "examples": [
        {
          "source": "Я читал эту книгу два часа.",
          "translation": "这本书我读了两个小时。"
        },
        {
          "source": "Я прочитал эту книгу за два дня.",
          "translation": "我两天就把这本书读完了。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "Я прочитал книгу два часа.",
          "right": "Я читал книгу два часа.",
          "why": "два часа 表示持续的过程，必须用未完成体；完成体强调动作已经结束。"
        },
        {
          "wrong": "Завтра я буду прочитать книгу.",
          "right": "Завтра я прочитаю книгу.",
          "why": "完成体不能和 буду 连用，它的将来意义由现在时形式承担。"
        }
      ],
      "related": [
        "ru-past",
        "ru-negation"
      ],
      "links": [
        {
          "label": "Russian verbs · Aspect",
          "url": "https://en.wikipedia.org/wiki/Russian_verbs",
          "site": "Wikipedia"
        },
        {
          "label": "RussianLessons.net · Grammar",
          "url": "https://www.russianlessons.net/grammar/",
          "site": "RussianLessons.net"
        }
      ],
      "patterns": [
        "\\b(прочитал|прочитала|написал|сделал|прочитаю|напишу)\\b",
        "\\b(читал|читала|писал|делал|читаю|пишу)\\b"
      ],
      "sample": "Вчера я прочитал эту книгу за два дня.",
      "priority": 6,
      "confidence": 0.87
    },
    {
      "id": "ru-past",
      "language": "ru",
      "title": "过去时",
      "english": "Russian Past Tense",
      "category": "时态",
      "cefr": "A1",
      "formula": "不定式去 -ть + -л / -ла / -ло / -ли",
      "summary": "俄语过去时只随性、数变化，不随人称变化。阳性 -л，阴性 -ла，中性 -ло，复数 -ли。",
      "sections": [
        {
          "heading": "构成",
          "body": "去掉不定式的 -ть，再加 -л 系列词尾。少数动词词干会变化，需要单独记。",
          "bullets": [
            "читать → читал / читала / читало / читали",
            "говорить → говорил / говорила",
            "идти → шёл / шла / шло / шли"
          ]
        },
        {
          "heading": "性数一致",
          "body": "主语是阴性就用 -ла，中性用 -ло，复数一律 -ли，不再区分性别。过去时没有人称词尾，所以 я、ты、он 的形式可能相同。"
        },
        {
          "heading": "体与时",
          "body": "过去时同样分体：читал 强调当时在读，прочитал 强调已经读完。叙事里两者交替出现，形成背景与事件的层次。"
        }
      ],
      "examples": [
        {
          "source": "Вчера она написала письмо бабушке.",
          "translation": "昨天她给奶奶写了一封信。"
        },
        {
          "source": "Мы долго гуляли по городу.",
          "translation": "我们在城里逛了很久。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "Она читал книгу.",
          "right": "Она читала книгу.",
          "why": "主语 она 是阴性，过去时要用 -ла。"
        },
        {
          "wrong": "Я идёл домой.",
          "right": "Я шёл домой.",
          "why": "идти 的过去时是 шёл / шла，属于不规则形式。"
        }
      ],
      "related": [
        "ru-aspect",
        "ru-word-order"
      ],
      "links": [
        {
          "label": "Russian grammar · Past tense",
          "url": "https://en.wikipedia.org/wiki/Russian_grammar",
          "site": "Wikipedia"
        },
        {
          "label": "Master Russian · Grammar",
          "url": "https://masterrussian.com/",
          "site": "Master Russian"
        }
      ],
      "patterns": [
        "\\b(написала|читала|гуляли|пришёл|шла|были|сказал)\\b",
        "\\b[а-яё]+(л|ла|ло|ли)\\s+(книгу|письмо|домой|вчера)\\b"
      ],
      "sample": "Вчера она написала письмо бабушке.",
      "priority": 5,
      "confidence": 0.86
    },
    {
      "id": "ru-word-order",
      "language": "ru",
      "title": "语序与信息结构",
      "english": "Russian Word Order and Information Structure",
      "category": "语序",
      "cefr": "B1",
      "formula": "中性语序 SVO；已知信息在前，焦点信息放句末",
      "summary": "俄语语序灵活，格标记保证句法关系。改变词序主要改变信息结构：什么已知、什么才是新信息。",
      "sections": [
        {
          "heading": "中性语序",
          "body": "没有特殊强调时按主谓宾排列，句末自然承载新信息，这也是最保险的写法。",
          "bullets": [
            "Мама купила молоко.",
            "Студент читает книгу."
          ]
        },
        {
          "heading": "焦点后置",
          "body": "回答“谁买了牛奶”时把新信息放到句末，语序随之倒装。俄语靠这种位置变化而不是靠重音来标记焦点。",
          "bullets": [
            "Молоко купила мама.",
            "Книгу принёс брат."
          ]
        },
        {
          "heading": "倒装强调",
          "body": "把宾语提前会形成对比话题，暗示“这个而不是别的”。口语里语调也参与区分，书面语只能靠词序。"
        }
      ],
      "examples": [
        {
          "source": "Молоко купила мама.",
          "translation": "牛奶是妈妈买的。"
        },
        {
          "source": "Эту книгу я прочитал ещё в школе.",
          "translation": "这本书我在中学时就读过了。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "Кто купил молоко? — Мама купила молоко.",
          "right": "Кто купил молоко? — Молоко купила мама.",
          "why": "回答疑问词时焦点应落在句末，重复已知的 молоко 会让答句显得生硬。"
        },
        {
          "wrong": "Книгу я прочитал вчера ради удовольствия.",
          "right": "Я прочитал книгу вчера ради удовольствия.",
          "why": "没有对比意图时宾语不必前置，前置会额外带出“这本书”的话题意味。"
        }
      ],
      "related": [
        "ru-aspect",
        "ru-negation"
      ],
      "links": [
        {
          "label": "Russian grammar · Word order",
          "url": "https://en.wikipedia.org/wiki/Russian_grammar",
          "site": "Wikipedia"
        },
        {
          "label": "LearnRussian · Grammar",
          "url": "https://learnrussian.rt.com/",
          "site": "LearnRussian (RT)"
        }
      ],
      "patterns": [
        "\\b(эту|этот|это|эти)\\s+[а-яё]+\\s+(я|ты|он|она|мы|вы|они)\\b",
        "\\b[А-ЯЁ][а-яё]+\\s+(купила|принёс|прочитал)\\s+[А-ЯЁ][а-яё]+\\b"
      ],
      "sample": "Эту книгу я прочитал ещё в школе.",
      "priority": 4,
      "confidence": 0.79
    },
    {
      "id": "ru-negation",
      "language": "ru",
      "title": "否定",
      "english": "Russian Negation",
      "category": "否定",
      "cefr": "A2",
      "formula": "не + 动词；нет + 属格；否定代词与 не 同现",
      "summary": "俄语用 не 否定谓语，用 нет 加属格否定存在。否定代词出现时 не 仍要保留，形成多重否定。",
      "sections": [
        {
          "heading": "否定谓语",
          "body": "не 直接放在动词前面，几乎是最简单的否定方式。否定形容词和副词也用同一个 не。",
          "bullets": [
            "Я не знаю.",
            "Он не пришёл на встречу.",
            "Это не моя книга."
          ]
        },
        {
          "heading": "存在否定",
          "body": "说“没有某物”用 нет，后面的名词要变成属格。过去和将来则用 не было / не будет，同样接属格。",
          "bullets": [
            "У меня нет времени.",
            "Здесь нет магазина."
          ]
        },
        {
          "heading": "双重否定",
          "body": "никто、ничего、никогда、нигде 必须与 не 同时出现，这不是错误而是规范。缺少 не 的句子反而不合语法。"
        }
      ],
      "examples": [
        {
          "source": "У меня нет свободного времени.",
          "translation": "我没有空闲时间。"
        },
        {
          "source": "Он никогда не опаздывает на работу.",
          "translation": "他上班从不迟到。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "У меня нет время.",
          "right": "У меня нет времени.",
          "why": "нет 后面的名词必须用属格，время 的属格是 времени。"
        },
        {
          "wrong": "Я не знаю ничего.",
          "right": "Я ничего не знаю.",
          "why": "否定代词通常放在动词前，не 也不能省，语序比逐字对应更重要。"
        }
      ],
      "related": [
        "ru-aspect",
        "ru-word-order"
      ],
      "links": [
        {
          "label": "Russian grammar · Negation",
          "url": "https://en.wikipedia.org/wiki/Russian_grammar",
          "site": "Wikipedia"
        },
        {
          "label": "RussianLessons.net · Grammar",
          "url": "https://www.russianlessons.net/grammar/",
          "site": "RussianLessons.net"
        }
      ],
      "patterns": [
        "\\bне\\s+(знаю|был|была|хочу|может|пришёл|опаздывает|работает)\\b",
        "\\b(нет|не было|не будет)\\s+[а-яё]+(а|я|и|ы|время|времени)\\b"
      ],
      "sample": "Он никогда не опаздывает на работу.",
      "priority": 5,
      "confidence": 0.85
    },
    {
      "id": "uk-cases",
      "language": "uk",
      "title": "七格系统",
      "english": "Ukrainian Seven Cases",
      "category": "格",
      "cefr": "A2",
      "formula": "називний / родовий / давальний / знахідний / орудний / місцевий / кличний",
      "summary": "乌克兰语保留七个格，比俄语多出一个呼格。格由词尾和介词共同标示，是读懂句子关系的关键。",
      "sections": [
        {
          "heading": "七格功能",
          "body": "主格作主语，属格表所属和否定，与格表接受者，宾格作直接宾语，工具格表工具与方式，位格表地点，呼格用于称呼。",
          "bullets": [
            "книга（主格）",
            "книги（属格）",
            "книзі（与格/位格）",
            "книгу（宾格）",
            "книгою（工具格）",
            "книго!（呼格）"
          ]
        },
        {
          "heading": "介词支配",
          "body": "в/у 表地点时接位格，表方向时接宾格；до 接属格，з 接工具格。介词几乎决定了后面必须用哪个格。",
          "bullets": [
            "в Києві（在基辅）",
            "в Київ（去基辅）",
            "до Києва（到基辅）"
          ]
        },
        {
          "heading": "形容词一致",
          "body": "形容词、物主代词要和名词的性数格一起变化。цей / ця / це 在宾格阴性里变成 цю。"
        }
      ],
      "examples": [
        {
          "source": "Я читаю цікаву книгу.",
          "translation": "我在读一本有趣的书。"
        },
        {
          "source": "Ми говоримо про нову роботу.",
          "translation": "我们在谈新工作。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "Я живу в Київ.",
          "right": "Я живу в Києві.",
          "why": "表示所在地点时 в 接位格，Київ 的位格是 Києві。"
        },
        {
          "wrong": "Я читаю книга.",
          "right": "Я читаю книгу.",
          "why": "直接宾语用宾格，阴性 -а 变成 -у。"
        }
      ],
      "related": [
        "uk-vocative",
        "uk-aspect"
      ],
      "links": [
        {
          "label": "Ukrainian grammar · Cases",
          "url": "https://en.wikipedia.org/wiki/Ukrainian_grammar",
          "site": "Wikipedia"
        },
        {
          "label": "Ukrainian Lessons",
          "url": "https://www.ukrainianlessons.com/",
          "site": "Ukrainian Lessons"
        }
      ],
      "patterns": [
        "\\b(у|в)\\s+[А-ЯІЇЄҐа-яіїєґ]+(і|ї|ові|еві)\\b",
        "\\b(книгу|роботу|мову|статтю|каву)\\b"
      ],
      "sample": "Я живу в Києві.",
      "priority": 6,
      "confidence": 0.85
    },
