    {
      "id": "pl-cases",
      "language": "pl",
      "title": "七格系统",
      "english": "Polish Seven Cases",
      "category": "格",
      "cefr": "A2",
      "formula": "mianownik / dopełniacz / celownik / biernik / narzędnik / miejscownik / wołacz",
      "summary": "波兰语有七个格，名词和形容词的词尾要一起变化。用哪个格由句法角色和介词共同决定。",
      "sections": [
        {
          "heading": "七格功能",
          "body": "主格作主语，属格表所属与否定宾语，与格表接受者，宾格作直接宾语，工具格表工具与交通方式，位格只用于介词后表地点或话题，呼格用于称呼。",
          "bullets": [
            "kobieta（主格）",
            "kobiety（属格）",
            "kobiecie（与格/位格）",
            "kobietę（宾格）",
            "kobietą（工具格）",
            "kobieto!（呼格）"
          ]
        },
        {
          "heading": "介词支配",
          "body": "do 接属格，ku 接与格，z 接工具格，w 表地点时接位格。记住介词搭配比死背词尾表更实用。",
          "bullets": [
            "do Warszawy",
            "z przyjacielem",
            "w Warszawie"
          ]
        },
        {
          "heading": "形容词一致",
          "body": "形容词必须跟着名词的性数格走：nowy dom、nowa książka、nowe okno，宾格阴性则是 nową książkę。"
        }
      ],
      "examples": [
        {
          "source": "Czytam ciekawą książkę.",
          "translation": "我在读一本有趣的书。"
        },
        {
          "source": "Mieszkam w Warszawie od pięciu lat.",
          "translation": "我在华沙住了五年。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "Mieszkam w Warszawa.",
          "right": "Mieszkam w Warszawie.",
          "why": "w 表示所在地点时接位格，Warszawa 的位格是 Warszawie。"
        },
        {
          "wrong": "Czytam książka.",
          "right": "Czytam książkę.",
          "why": "直接宾语用宾格，阴性 -a 变成 -ę。"
        }
      ],
      "related": [
