    {
      "id": "pl-negation",
      "language": "pl",
      "title": "否定",
      "english": "Polish Negation",
      "category": "否定",
      "cefr": "A2",
      "formula": "nie + 动词；否定宾语常用属格；否定代词与 nie 同现",
      "summary": "波兰语用 nie 否定谓语。否定及物动词的宾语常变属格，否定代词出现时 nie 必须保留。",
      "sections": [
        {
          "heading": "否定谓语",
          "body": "nie 放在动词或形容词前面，是最基本的否定手段。它和后面的词通常连写。",
          "bullets": [
            "Nie znam tego człowieka.",
            "On nie przyszedł na spotkanie."
          ]
        },
        {
          "heading": "属格否定",
          "body": "肯定句里的宾格宾语，在否定句里常变成属格。这条规则在“没有、不知道、没看见”一类动词上最明显。",
          "bullets": [
            "Mam czas. → Nie mam czasu.",
            "Widzę samochód. → Nie widzę samochodu."
          ]
        },
        {
          "heading": "双重否定",
          "body": "nikt、nic、nigdy、nigdzie 必须和 nie 一起出现。少写 nie 会被判为语法错误，而不是“更简洁”。"
        }
      ],
      "examples": [
        {
          "source": "Nie mam dzisiaj czasu.",
          "translation": "我今天没有时间。"
        },
        {
          "source": "Nigdy nie byłem w Krakowie.",
          "translation": "我从没去过克拉科夫。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "Nie mam czas.",
          "right": "Nie mam czasu.",
          "why": "否定及物动词的宾语用属格，czas 的属格是 czasu。"
        },
        {
          "wrong": "Nikt przyszedł na spotkanie.",
          "right": "Nikt nie przyszedł na spotkanie.",
          "why": "否定代词 nikt 所在的句子必须加 nie。"
        }
      ],
      "related": [
        "pl-cases",
        "pl-conditional"
      ],
      "links": [
        {
          "label": "Polish grammar · Negation",
          "url": "https://en.wikipedia.org/wiki/Polish_grammar",
          "site": "Wikipedia"
        },
