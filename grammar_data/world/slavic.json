          "url": "https://mowicpopolsku.com/",
          "site": "Mówić po polsku"
        }
      ],
      "patterns": [
        "\\bnie\\s+(mam|masz|ma|znam|wiem|było|byłem|przyszedł|widzę)\\b",
        "\\b(nikt|nigdy|nic|nigdzie)\\s+nie\\b",
        "\\bnie\\b"
      ],
      "sample": "Nie mam dzisiaj czasu.",
      "priority": 5,
      "confidence": 0.84
    }
