    {
      "id": "pl-aspect",
      "language": "pl",
      "title": "动词体",
      "english": "Polish Verbal Aspect",
      "category": "体",
      "cefr": "A2",
      "formula": "niedokonany ↔ dokonany：前缀 prze-/na-/z-/po- 或后缀 -ywa-/-iwa-",
      "summary": "波兰语动词成对出现。未完成体表过程与习惯，完成体表结果与一次完成。",
      "sections": [
        {
          "heading": "体的对立",
          "body": "czytać 是读的过程，przeczytać 是读完的结果。词典通常以未完成体为词条，再标注对应的完成体。",
          "bullets": [
            "czytać — przeczytać",
            "pisać — napisać",
            "robić — zrobić"
          ]
        },
        {
          "heading": "构成",
          "body": "加前缀最常见，其次是后缀替换，也有异干对。前缀常常同时带来结果或方向的意味。",
          "bullets": [
            "前缀：pisać → napisać",
            "后缀：otwierać → otworzyć",
            "异干：mówić → powiedzieć"
          ]
        },
        {
          "heading": "用法",
          "body": "叙述事件顺序用完成体，描写背景和重复习惯用未完成体。完成体没有现在时，其现在时形式表示将来。"
        }
      ],
      "examples": [
        {
          "source": "Czytałem tę książkę dwie godziny.",
          "translation": "这本书我读了两个小时。"
        },
        {
          "source": "Przeczytałem tę książkę w dwa dni.",
          "translation": "我两天就把这本书读完了。"
        }
      ],
      "pitfalls": [
        {
          "wrong": "Przeczytałem książkę dwie godziny.",
          "right": "Czytałem książkę dwie godziny.",
          "why": "dwie godziny 表示持续的时段，要用未完成体。"
        },
        {
          "wrong": "Jutro będę przeczytać książkę.",
          "right": "Jutro przeczytam książkę.",
          "why": "będę 只能接未完成体不定式，完成体将来用现在时形式。"
        }
      ],
      "related": [
